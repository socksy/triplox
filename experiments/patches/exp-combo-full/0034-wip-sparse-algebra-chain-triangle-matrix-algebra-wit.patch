+    /// Whether the algebra path claims this query, checked without running the engine twice.
+    fn handled<D, M>(query: &str, db: &Arc<DB<D, M>>) -> bool
+    where
+        D: DbReadOps + Send + Sync + 'static,
+        M: DbMetadataOps + Send + Sync + 'static,
