+        for query in queries {
+            // Matrix builds block on SlateDB, so this cannot run on the async worker.
+            let (owned, db) = (query.to_string(), Arc::clone(algebra));
+            let claimed = tokio::task::spawn_blocking(move || handled(&owned, &db))
+                .await
+                .unwrap();
