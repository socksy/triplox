@@ -8,7 +8,7 @@
 //! exactly the segment that could contain `target`. Readers accept both layouts in the
 //! same index, so the writer's segment size can change between transactions.
 
-use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::LazyLock;
 
 use anyhow::{bail, Result};
 use bytes::Bytes;
@@ -29,16 +29,13 @@ pub fn configured_segment_size() -> usize {
         .unwrap_or(1)
 }
 
-// Key-count estimates come from SST statistics and count SlateDB keys, not datoms. The
-// writer publishes its segment size here so estimates stay proportional across layouts.
-static ESTIMATE_SCALE: AtomicUsize = AtomicUsize::new(1);
-
-pub fn set_estimate_scale(segment_size: usize) {
-    ESTIMATE_SCALE.store(segment_size.max(1), Ordering::Relaxed);
-}
+// Key-count estimates come from SST statistics and count SlateDB keys, not datoms, so
+// the planner scales them by the configured segment size to stay comparable. Read once
+// per process: a per-database override would have to reach the planner another way.
+static ESTIMATE_SCALE: LazyLock<u64> = LazyLock::new(|| configured_segment_size() as u64);
 
 pub fn estimate_scale() -> u64 {
-    ESTIMATE_SCALE.load(Ordering::Relaxed) as u64
+    *ESTIMATE_SCALE
 }
 
 pub fn encode_segment(keys: &[Bytes]) -> Vec<u8> {
